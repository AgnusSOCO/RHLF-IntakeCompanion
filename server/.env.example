# --- Server ---
PORT=8080
# Shared bearer token the companion app and agent UI present. PoC only -
# replace with per-agent SSO sessions before production.
AGENT_TOKEN=change-me

# --- Deepgram (streaming STT) ---
DEEPGRAM_API_KEY=
DG_MODEL=nova-3
# Language handling: "multi" enables EN/ES code-switching on Nova-3.
DG_LANGUAGE=multi

# --- RingCentral RingEX ---
# Leave blank to run without real call events (use /dev/call-event to inject).
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# Public HTTPS URL of this server for webhook delivery (e.g. via tunnel).
PUBLIC_URL=
# Secret echoed back during webhook validation; set any strong random value.
RC_WEBHOOK_VERIFICATION_TOKEN=

# Path to the approved objection playbook.
PLAYBOOK_PATH=../playbook/playbook.json
